# PassPoint — variables de entorno (SPEC §7)
# Copia este archivo a .env y rellena los valores reales.
# Los valores reales NUNCA se versionan (ver .gitignore). Pide acceso al gestor de secretos.

# --- Base de datos / Auth (Supabase Postgres) ---
DATABASE_URL="postgresql://usuario:password@host:5432/passpoint?schema=public"
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_KEY="service-role-key-solo-backend"

# --- IA (solo pipeline de contenido en /content-factory, NO runtime del producto) ---
GEMINI_API_KEY="tu-api-key-de-gemini"

# --- Pagos (Stripe) ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Email transaccional (Resend) ---
RESEND_API_KEY="re_xxx"

# --- App ---
APP_BASE_URL="http://localhost:5173"
